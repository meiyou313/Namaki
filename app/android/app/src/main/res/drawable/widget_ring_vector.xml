<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's ring, connected, as a vector: a white disc with a bright
  green ring. The ring is fully drawn by default, so launchers that do
  not animate the vector still show the finished picture; the animated
  version (widget_ring_on_anim) sweeps the ring in from the top when the
  VPN connects. The ring path starts at the top (12 o'clock) and runs
  clockwise, matching the static widget_ring_on drawable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- The white disc. -->
    <path
        android:name="disc"
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,0a24,24 0,1 1,0 48a24,24 0,1 1,0 -48z" />
    <!-- The ring, fully drawn by default. -->
    <path
        android:name="ring"
        android:fillColor="@android:color/transparent"
        android:pathData="M24,1.5a22.5,22.5 0,1 1,0 45a22.5,22.5 0,1 1,0 -45z"
        android:strokeWidth="2.5"
        android:strokeColor="#00E676"
        android:trimPathEnd="1" />
</vector>
