<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's ring, off: a white disc with a near-black ring, like the
  reference's white circle. The inset keeps the stroke inside the view:
  a shape's stroke is centred on its edge, so without it half the
  stroke would be clipped. The hen (widget_hen) sits on top of this.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="2dp">
    <shape android:shape="oval">
        <solid android:color="#FFFFFFFF" />
        <stroke
            android:width="2.5dp"
            android:color="#1A1A1A" />
    </shape>
</inset>
