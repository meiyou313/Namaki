<?xml version="1.0" encoding="utf-8"?>
<!-- Draws the widget's check mark in when the VPN connects. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="trimPathEnd"
    android:valueFrom="0"
    android:valueTo="1"
