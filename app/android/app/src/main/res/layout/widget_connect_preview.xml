<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (Android 12+): the circle, connected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The white disc and the bright green ring. -->
    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_ring_on" />

    <!-- The hen, a little smaller than the disc so a white rim shows. -->
    <ImageView
        android:id="@+id/widget_hen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_hen" />
</FrameLayout>
