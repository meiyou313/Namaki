<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: a small circular 1x1 button — the hen on a
     white disc with a state ring (near-black off, amber connecting,
     bright green connected). No text: the whole circle is the toggle.
     ConnectWidget puts the tap on the root. The ring sweeps itself in
     when the VPN connects (widget_ring_on_anim); on launchers that do
     not animate vectors in widgets the ring's finished frame is shown.
     The off state is the default shown here, also after a reboot before
     the first update. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The white disc and the state ring around it. -->
    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_ring_off" />

    <!-- The hen, a little smaller than the disc so a white rim shows
         around her, like the plug in the reference. -->
    <ImageView
        android:id="@+id/widget_hen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_hen" />
</FrameLayout>
